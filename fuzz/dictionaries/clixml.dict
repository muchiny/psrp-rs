# libFuzzer dictionary for the CLIXML parser (MS-PSRP §2.2.5).
#
# Every token the decoder branches on. Without these the fuzzer has to
# rediscover the tag alphabet byte by byte, which wastes most of the
# budget before it ever reaches the interesting nesting logic.

# --- primitive value tags ---
"<S>"
"</S>"
"<B>"
"</B>"
"<Nil/>"
"<SB>"
"<By>"
"<I16>"
"<U16>"
"<I32>"
"</I32>"
"<U32>"
"<I64>"
"<U64>"
"<Sg>"
"<Db>"
"</Db>"
"<D>"
"<C>"
"<BA>"
"<DT>"
"<TS>"
"<G>"
"<Version>"
"<URI>"
"<XD>"
"<SCT>"
"<SS>"

# --- structure ---
"<Objs>"
"</Objs>"
"<Obj>"
"</Obj>"
"<Obj RefId=\"0\">"
"<MS>"
"</MS>"
"<Props>"
"<TN RefId=\"0\">"
"</TN>"
"<TNRef RefId=\"0\"/>"
"<T>"
"</T>"
"<ToString>"
"<LST>"
"</LST>"
"<IE>"
"<QUE>"
"<STK>"
"<DCT>"
"</DCT>"
"<En>"
"</En>"
"<Ref RefId=\"0\"/>"

# --- attributes ---
" N=\""
" RefId=\""
"N=\"Key\""
"N=\"Value\""

# --- float / bool literals the parser special-cases ---
"NaN"
"Infinity"
"-Infinity"
"true"
"false"

# --- escapes and lexical traps ---
"_x0000_"
"_x000A_"
"_x005F_"
"&lt;"
"&gt;"
"&amp;"
"&quot;"
"&apos;"
"&#x41;"
"<![CDATA["
"]]>"
"\xef\xbb\xbf"
"<?xml version=\"1.0\"?>"
"<!-- -->"

# --- property names the typed records look for ---
"N=\"Exception\""
"N=\"Message\""
"N=\"CategoryInfo\""
"N=\"InvocationInfo\""
"N=\"FullyQualifiedErrorId\""
"N=\"RunspaceState\""
"N=\"PipelineState\""
"N=\"ActivityId\""
"N=\"PercentComplete\""
"N=\"MessageData\""
"N=\"Tags\""
"_value"
