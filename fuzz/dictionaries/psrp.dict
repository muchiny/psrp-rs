# libFuzzer dictionary for the PSRP fragment + message layers.
#
# Fragment header (MS-PSRP §2.2.4), 21 bytes big-endian:
#   ObjectId u64 | FragmentId u64 | Flags u8 | BlobLength u32
# Message header (§2.2.2), 40 bytes:
#   Destination u32LE | MessageType u32LE | RPID Guid | PID Guid

# --- fragment flag bytes ---
"\x00"
"\x01"
"\x02"
"\x03"

# --- whole fragment headers: object 1, fragment 0, start+end, len N ---
"\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00"
"\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x28"
"\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x80\x00"

# --- destinations (u32 little-endian) ---
"\x01\x00\x00\x00"
"\x02\x00\x00\x00"

# --- message types (u32 little-endian, §2.2.2.1) ---
"\x02\x00\x01\x00"
"\x04\x00\x01\x00"
"\x05\x00\x01\x00"
"\x06\x00\x01\x00"
"\x07\x00\x01\x00"
"\x08\x00\x01\x00"
"\x0a\x00\x01\x00"
"\x0b\x00\x01\x00"
"\x01\x00\x04\x00"
"\x02\x00\x04\x00"
"\x03\x00\x04\x00"
"\x04\x00\x04\x00"
"\x05\x00\x04\x00"
"\x06\x00\x04\x00"
"\x10\x00\x04\x00"
"\x21\x00\x04\x00"

# --- nil / all-ones GUIDs ---
"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

# --- BOM the message decoder strips ---
"\xef\xbb\xbf"
